---
/**
 * Sessions — the working page. Owned by Agent C (SPEC.md § Sessions page).
 *
 * Order, per spec: 1 intro · 2 track cards · 3 investment tiers · 4 booking
 * embeds (with 5 testimonials sat above each) · 6 FAQ · 7 enquiry.
 *
 * Stable anchors for Agent D's JSON-LD / any deep links:
 *   #consult  #book  #investment  #faq  #inquire
 *
 * Smooth in-page scrolling comes from `html { scroll-behavior: smooth }` in
 * global.css, which already disables itself under prefers-reduced-motion.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';
import SessionsJsonLd from '../components/SessionsJsonLd.astro';
import CalEmbed from '../components/CalEmbed.astro';
import Faq from '../components/Faq.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { SITE } from '../config';

interface Tier {
  name: string;
  price: string;
  summary: string;
  deliverables: string[];
}

/* Pricing set Aug 2026 from NYC market research: bottom edge of the professional
   band ($250+ credibility floor), each tier just under a named competitor while
   including slightly more. Review every January; raise 10-20% once >60% of
   inquiries book. */
const TIERS: Tier[] = [
  {
    name: 'Headshot Session',
    price: '$395',
    summary: 'An hour, two looks, and you leave with headshots you actually like.',
    deliverables: [
      '60 minutes, up to two looks, studio or on-location in Manhattan/Brooklyn',
      'Proof gallery of 30–40 selects within 24 hours',
      '2 fully retouched finals within 72 hours, high-res + web crops',
      'Unlimited personal and professional use, no expiration',
      'Extra retouched image $65 · extra look $100',
    ],
  },
  {
    name: 'Portrait Session',
    price: '$650',
    summary: 'Three looks, two settings, and time to get past the stiff first ten minutes.',
    deliverables: [
      '2 hours, up to three looks, one studio setup plus one exterior location',
      'Planning call, moodboard and shot list before the shoot',
      'Proof gallery of 50–70 selects within 48 hours',
      '8 fully retouched finals within 5 business days',
      'Unlimited personal and self-promotional use',
    ],
  },
  {
    name: 'Half-Day Creative',
    price: '$1,450',
    summary: 'A produced shoot. We plan it like a small production because it is one.',
    deliverables: [
      '4 hours, up to five looks across 2–3 setups, studio and/or location',
      'Full pre-production: concept call, moodboard, shot list, scouting',
      'Proof gallery of 100–150 selects within 3 days; 20 retouched finals in 10',
      'One-year usage on owned and organic channels; paid media quoted separately',
      'Studio rental and permits billed at cost',
    ],
  },
];

---

<BaseLayout>
  <Seo
    slot="head"
    title="Sessions"
    description="Book a photography session in New York: creative portraiture projects and standard headshot sessions."
    ogImage="/og/sessions.jpg"
  />
  <SessionsJsonLd slot="head" />
  {/* 1. Intro ------------------------------------------------------------ */}
  <div class="column">
    <h1>Sessions</h1>
    <p class="lede">
      Two ways to work together: a custom creative project, or a standard session you can book
      directly.
    </p>
  </div>

  {/* 2. Track cards ------------------------------------------------------ */}
  <div class="column-wide section">
    <h2 class="visually-hidden">Ways to work together</h2>
    <div class="tracks">
      <article class="card track">
        <span class="eyebrow">Creative portraiture</span>
        <h3 class="track__name">Start a project</h3>
        <p class="track__pitch">
          Concept portraiture built around an idea. We plan location, styling and light together
          before anyone picks up a camera. Editorial, album art, personal work that should
          look like yours and nobody else&rsquo;s.
        </p>
        <p class="track__note">Custom projects start with a conversation.</p>
        <a class="button" href="#consult">Book a consult</a>
      </article>

      <article class="card track">
        <span class="eyebrow">Headshots &amp; standard sessions</span>
        <h3 class="track__name">Book now</h3>
        <p class="track__pitch">
          Fixed scope, fixed price, on the calendar in about two minutes. Headshots, portraits and
          straightforward personal sessions where you already know what you need.
        </p>
        <p class="track__note">Pick a time that works.</p>
        <a class="button" href="#book">See open times</a>
      </article>
    </div>
  </div>

  {/* 3. Investment ------------------------------------------------------- */}
  <section class="column-wide section section--ruled" id="investment" aria-labelledby="investment-heading">
    <span class="eyebrow">Investment</span>
    <h2 id="investment-heading">What sessions cost</h2>

    <div class="tiers">
      {
        TIERS.map((tier) => (
          <article class="card tier">
            <h3 class="tier__name">{tier.name}</h3>
            <p class="tier__price">Starting at {tier.price}</p>
            <p class="tier__summary">{tier.summary}</p>
            <ul class="tier__list" role="list">
              {tier.deliverables.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <p class="tiers__footnote">
      Editorial and concept work gets a custom quote after a consult. Creative fees start at
      $2,000 a day, with usage and production scoped separately.
    </p>
  </section>

  {/*
   * 4 + 5. Booking. Testimonial slots are OFF the page until real quotes exist
   * (ask GL and VP) — visible placeholder praise reads as broken, not humble.
   * When they land: <Testimonial name="…" role="…">quote</Testimonial> above
   * each CalEmbed, component is ready in src/components/Testimonial.astro.
   */}
  <div class="column-wide section section--ruled">
    <CalEmbed
      id="consult"
      eyebrow="Creative portraiture"
      heading="Free 20-minute consult"
      calLink={SITE.calConsult}
    >
      <p>
        No pitch. We talk through the idea, the people, the location and the budget, and I tell you
        straight whether I&rsquo;m the right photographer for it.
      </p>
    </CalEmbed>
  </div>

  <div class="column-wide section">
    <CalEmbed
      id="book"
      eyebrow={'Headshots & standard sessions'}
      heading="Book a session"
      calLink={SITE.calHeadshots}
    >
      <p>
        Pick a slot and it&rsquo;s yours. A $150 deposit reserves the date and comes off your
        session total; the balance is due on the day of the shoot. Half-day and custom projects
        book with a 50% deposit instead.
      </p>
    </CalEmbed>
  </div>

  {/* 6. FAQ -------------------------------------------------------------- */}
  <section class="column section section--ruled" id="faq" aria-labelledby="faq-heading">
    <span class="eyebrow">Questions</span>
    <h2 id="faq-heading">Before you book</h2>

    <div class="faqs">
      <Faq q="How long until I get my photos?">
        <p>
          Headshots come back within a week. Portrait sessions take about two, and half-day
          projects up to three. Either way, a small preview reaches you inside 48 hours so you
          have something to use right away. On a deadline? Tell me before you book and I&rsquo;ll
          see what the calendar allows.
        </p>
      </Faq>

      <Faq q="What am I allowed to do with the images?">
        <p>
          Print them, post them, put them on your website. Personal use is all included. If the
          images are going to sell something (ads, packaging, paid campaigns), that&rsquo;s a
          commercial license and I quote it per project.
        </p>
        <p>
          I keep the copyright and the right to show the work in my portfolio. Want a shoot kept
          private? Tell me before we shoot and we&rsquo;ll put it in writing.
        </p>
      </Faq>

      <Faq q="Do you travel?">
        <p>
          I&rsquo;m based in New York, and anywhere in the five boroughs is included. Past about an
          hour out I add a travel fee. Multi-day and out-of-state work gets quoted with travel and
          lodging built in. I like location work, so if you have somewhere in mind, bring it to
          the consult.
        </p>
      </Faq>

      <Faq q="What happens if the weather turns?">
        <p>
          Overcast is actually good news: soft light, no squinting. We only move the shoot when
          the weather makes the work impossible, think heavy rain or lightning. I make that call
          with you the morning of, and we pick the next date that works for both of us. No fee.
        </p>
      </Faq>

      <Faq q="Can I reschedule or cancel?">
        <p>
          Your date is held by a $150 deposit that comes off your session total; bigger projects
          book at half the total instead. Plans change: reschedule free with 48 hours notice, and
          cancellations a week or more out get a full refund. Inside a week, the deposit stays as
          credit toward a new date.
        </p>
        <p>
          Same-day cancellations and no-shows forfeit the deposit. If I ever have to cancel, you
          get a full refund or a free reschedule, your pick. And weather never counts against you.
        </p>
      </Faq>

      <Faq q="What should I wear?">
        <p>
          Solid colors and simple shapes photograph best. The two most common regrets are busy
          patterns and a haircut from the day before. Bring two or three options on hangers and
          we&rsquo;ll pick together. The full prep list comes with your booking confirmation.
        </p>
      </Faq>
    </div>
  </section>

  {/* 8. Enquiry ---------------------------------------------------------- */}
  <section class="column section section--ruled" id="inquire" aria-labelledby="inquire-heading">
    <span class="eyebrow">Inquiries</span>
    <h2 id="inquire-heading">Something else in mind?</h2>
    <p class="muted">
      Editorial commissions, unusual locations, anything that doesn&rsquo;t fit a tier. Tell me
      about it and I&rsquo;ll come back with a plan and a number.
    </p>
    <InquiryForm />
  </section>
</BaseLayout>

<style>
  /* --- 2. Track cards ---------------------------------------------------- */

  .tracks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .track {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: var(--space-6);
  }

  .track__name {
    font-size: 1.32rem;
  }

  .track__pitch {
    margin-top: var(--space-4);
    color: var(--ink-soft);
  }

  .track__note {
    margin-top: var(--space-4);
    margin-bottom: var(--space-5);
    font-family: var(--grotesque);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  /* Push the button to the bottom so both cards align regardless of copy. */
  .track .button {
    margin-top: auto;
  }

  /* --- 3. Tier cards ----------------------------------------------------- */

  .tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .tier {
    display: flex;
    flex-direction: column;
  }

  .tier__name {
    font-family: var(--serif);
    font-size: 1.24rem;
  }

  /* Numbers and hard data are always grotesque. */
  .tier__price {
    margin-top: var(--space-2);
    font-family: var(--grotesque);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--accent);
  }

  .tier__summary {
    margin-top: var(--space-4);
    font-size: 0.98rem;
    color: var(--ink-soft);
  }

  .tier__list {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--line);
    font-family: var(--grotesque);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .tier__list li + li {
    margin-top: var(--space-3);
  }

  .tier__list li {
    padding-left: var(--space-4);
    position: relative;
  }

  .tier__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background-color: var(--ink-faint);
  }

  .tiers__footnote {
    margin-top: var(--space-5);
    color: var(--ink-soft);
  }

  /* --- 6. FAQ ------------------------------------------------------------ */

  .faqs {
    margin-top: var(--space-5);
  }


  /* --- responsive -------------------------------------------------------- */

  @media (max-width: 880px) {
    .tiers {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 640px) {
    .tracks {
      grid-template-columns: minmax(0, 1fr);
    }

    .track {
      padding: var(--space-5);
    }
  }

</style>
