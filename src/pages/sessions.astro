---
/**
 * Sessions — the working page. One offer, kept deliberately simple
 * (owner-directed, Sep 2026): the Cinematic Portrait Session. No headshot tier
 * (no studio yet, and almost nobody who writes in wants one), no half-day, no
 * consult track. Anything outside the session goes to email.
 *
 * Order: 1 intro · 2 the session (scope + price) · 3 booking embed · 4 FAQ ·
 * 5 enquiry.
 *
 * Stable anchors for SessionsJsonLd / any deep links:
 *   #session  #book  #faq  #inquire
 *
 * Smooth in-page scrolling comes from `html { scroll-behavior: smooth }` in
 * global.css, which already disables itself under prefers-reduced-motion.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';
import SessionsJsonLd from '../components/SessionsJsonLd.astro';
import CalEmbed from '../components/CalEmbed.astro';
import Faq from '../components/Faq.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { SITE } from '../config';

/* The one session. Every number a client reads lives here, and nowhere else on
   the page; SessionsJsonLd.astro restates name, price and scope for search, so
   edit both or neither.

   Price set Aug 2026 from NYC market research (bottom edge of the professional
   band); review every January, raise 10-20% once more than 60% of inquiries
   book. Gallery and retouch counts mirror how Selects galleries actually run:
   every frame edited and downloadable, three favorites marked for full
   retouching. No shot list: the planning call and moodboard are the prep. */
const SESSION = {
  name: 'Cinematic Portrait Session',
  price: '$650',
  length: '2 hours',
  deposit: '$150',
  summary: 'Portraits that look like stills from a film. Real locations, real light, no studio.',
  includes: [
    '2 hours, up to 3 looks, 2 locations',
    'Planning call and moodboard before the shoot',
    '25–40 edited HDR frames in a private online gallery, within a week',
    '3 fully retouched favorites, your pick, within 5 business days',
    'Full-resolution downloads plus Instagram and RedNote sizes',
    'Unlimited personal use, no expiration',
  ],
  extras: 'Add a retouched frame: $65',
};
---

<BaseLayout>
  <Seo
    slot="head"
    title="Sessions"
    description="Cinematic portrait session in New York: two hours on location, 25–40 edited HDR frames, three fully retouched. $650, booked online."
    ogImage="/og/sessions.jpg"
  />
  <SessionsJsonLd slot="head" />

  {/* 1. Intro ------------------------------------------------------------ */}
  <div class="column">
    <h1>Sessions</h1>
    <p class="lede">
      Film-still portraits of you, anywhere in New York. Two hours, 25–40 finished HDR frames,
      three fully retouched. {SESSION.price}, booked online.
    </p>
  </div>

  {/* 2. The session ------------------------------------------------------ */}
  <section class="column-wide section" id="session" aria-labelledby="session-heading" data-ev-view="offer">
    <article class="card offer">
      <div class="offer__head">
        <div class="offer__title">
          <span class="eyebrow">The session</span>
          <h2 id="session-heading" class="offer__name">{SESSION.name}</h2>
          <p class="offer__summary">{SESSION.summary}</p>
        </div>

        {/* Numbers and hard data are always grotesque. */}
        <dl class="offer__facts">
          <div class="offer__fact offer__fact--price">
            <dt>Price</dt>
            <dd>{SESSION.price}</dd>
          </div>
          <div class="offer__fact">
            <dt>Length</dt>
            <dd>{SESSION.length}</dd>
          </div>
          <div class="offer__fact">
            <dt>Deposit</dt>
            <dd>{SESSION.deposit}</dd>
          </div>
        </dl>
      </div>

      <div class="offer__body">
        <div class="offer__pitch">
          <p>
            You leave with 25&ndash;40 finished frames, mastered in HDR so they look lit from
            within on a modern phone. Three of them fully retouched, your pick.
          </p>
          <p>
            Night streets, a subway window, your kitchen at golden hour. We build the scene
            around you. The city is the set.
          </p>
        </div>

        <div class="offer__includes">
          <h3 class="label label--ink">What you get</h3>
          <ul class="offer__list" role="list">
            {SESSION.includes.map((item) => <li>{item}</li>)}
          </ul>
          <p class="offer__extras">{SESSION.extras}</p>
        </div>
      </div>

      <div class="offer__actions">
        <a class="button" href="#book" data-ev="see-times">See open times</a>
        <span class="offer__note">Flat price. No packages.</span>
      </div>
    </article>
  </section>

  {/*
   * 3. Booking. Testimonial slots are OFF the page until real quotes exist
   * (ask GL and VP) — visible placeholder praise reads as broken, not humble.
   * When they land: <Testimonial name="…" role="…">quote</Testimonial> above
   * the CalEmbed, component is ready in src/components/Testimonial.astro.
   */}
  <div class="column-wide section section--ruled">
    <CalEmbed id="book" eyebrow="Booking" heading="Pick a date" calLink={SITE.calSession}>
      <p>
        Pick a slot and it&rsquo;s yours. {SESSION.deposit} deposit at booking, off the total.
        Balance due on the day. Questions first? <a href="#inquire">Email me</a>.
      </p>
    </CalEmbed>
  </div>

  {/* 4. FAQ -------------------------------------------------------------- */}
  <section class="column section section--ruled" id="faq" aria-labelledby="faq-heading" data-ev-view="faq">
    <span class="eyebrow">Questions</span>
    <h2 id="faq-heading">Before you book</h2>

    <div class="faqs">
      <Faq q="How long until I get my photos?">
        <p>
          Gallery within a week. Retouched favorites within five business days of your picks.
          On a deadline? Say so before you book.
        </p>
      </Faq>

      <Faq q="What am I allowed to do with the images?">
        <p>
          Print them, post them, put them on your site. Personal use is included. Ads,
          packaging or paid campaigns need a commercial license, quoted per project.
        </p>
        <p>
          I keep the copyright and portfolio rights. Want the shoot kept private? Say so before
          we shoot and it goes in writing.
        </p>
      </Faq>

      <Faq q="Where do we shoot?">
        <p>
          Anywhere in the five boroughs, included. I keep a shortlist of places that photograph
          like a set, or bring your own. More than an hour outside the city adds a travel fee.
        </p>
      </Faq>

      <Faq q="What happens if the weather turns?">
        <p>
          Overcast is good light. We only move for heavy rain or lightning, decided together
          the morning of. No fee.
        </p>
      </Faq>

      <Faq q="Can I reschedule or cancel?">
        <p>
          Reschedule free with 48 hours notice. Cancel a week or more out for a full refund.
          Inside a week, the {SESSION.deposit} deposit becomes credit toward a new date.
        </p>
        <p>
          Same-day cancellations and no-shows forfeit the deposit. If I cancel, you get a full
          refund or a free reschedule, your pick. Weather never counts against you.
        </p>
      </Faq>

      <Faq q="What should I wear?">
        <p>
          Solid colors, simple shapes. Skip busy patterns and the day-before haircut. Bring three
          outfits on hangers and we pick together. The full prep list comes with your booking
          confirmation.
        </p>
      </Faq>
    </div>
  </section>

  {/* 5. Enquiry ---------------------------------------------------------- */}
  <section class="column section section--ruled" id="inquire" aria-labelledby="inquire-heading" data-ev-view="inquire">
    <span class="eyebrow">Inquiries</span>
    <h2 id="inquire-heading">Something else in mind?</h2>
    <p class="muted">
      Groups, editorial, a location that needs a permit: email me and I&rsquo;ll tell you
      straight whether I can do it.
    </p>
    <InquiryForm />
  </section>
</BaseLayout>

<style>
  /* --- 2. The session ---------------------------------------------------- */

  .offer {
    padding: var(--space-6);
  }

  .offer__head {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: var(--space-6);
    align-items: start;
  }

  .offer__name {
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  }

  .offer__summary {
    margin-top: var(--space-4);
    color: var(--ink-soft);
  }

  /* Price, length, deposit: three mono facts on a hairline. */
  .offer__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
    margin: 0;
    padding-left: var(--space-5);
    border-left: 1px solid var(--line);
  }

  .offer__fact dt {
    font-family: var(--grotesque);
    font-size: 0.7rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
    color: var(--ink-faint);
  }

  .offer__fact dd {
    margin: var(--space-2) 0 0;
    font-family: var(--grotesque);
    font-size: 1.45rem;
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--ink);
    white-space: nowrap;
  }

  .offer__fact--price dd {
    color: var(--accent);
  }

  .offer__body {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px solid var(--line);
  }

  .offer__pitch {
    color: var(--ink-soft);
  }

  .offer__list {
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    font-family: var(--grotesque);
    font-size: 0.8rem;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .offer__list li + li {
    margin-top: var(--space-3);
  }

  .offer__list li {
    position: relative;
    padding-left: var(--space-4);
  }

  .offer__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 1px;
    background-color: var(--ink-faint);
  }

  .offer__extras,
  .offer__note {
    font-family: var(--grotesque);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--ink-faint);
  }

  .offer__extras {
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .offer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }

  /* --- 4. FAQ ------------------------------------------------------------ */

  .faqs {
    margin-top: var(--space-5);
  }

  /* --- responsive -------------------------------------------------------- */

  @media (max-width: 880px) {
    .offer__head,
    .offer__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .offer__facts {
      padding-left: 0;
      padding-top: var(--space-5);
      border-left: 0;
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 640px) {
    .offer {
      padding: var(--space-5);
    }

    .offer__facts {
      gap: var(--space-3);
    }

    .offer__fact dd {
      font-size: 1.2rem;
    }
  }
</style>
