---
/**
 * Overview — the curated stream. There is no other furniture on this page:
 * shoots run newest first, each set's frames full-width, one caption line under
 * each set. No lightbox, no genre nav (SPEC.md § Site map, § Content model).
 *
 * The <h1> is visually hidden on purpose: the photographs are the page, but the
 * document still needs one heading for screen readers and crawlers.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Seo from '../components/Seo.astro';
import PersonJsonLd from '../components/PersonJsonLd.astro';
import StreamFigure from '../components/StreamFigure.astro';
import { getStream } from '../lib/photos';
import { SITE } from '../config';

const stream = await getStream('overview');

/**
 * Editorial interstitial CTAs, keyed by the shoot slug they follow. Two,
 * deliberately: once early with the offer in one line, and as the closing
 * note. Caption-scale, quiet — the shoots are the pitch; these are just the
 * door. More would turn the gallery into a carousel ad.
 *
 * Keys must be shoots with `section: overview` (the default) AND a photo
 * ladder in public/photos/, or the CTA silently never renders. Today the
 * overview runs odyssey-period, contrast, longing, paprika, dynamic, lost.
 */
const STREAM_CTAS: Record<string, { eyebrow: string; text: string; href: string; label: string }> = {
  contrast: {
    eyebrow: 'Cinematic portrait session',
    text: 'Two hours on location. 25–40 finished HDR frames, three retouched. $650.',
    href: '/sessions/',
    label: 'See the session',
  },
  lost: {
    eyebrow: 'Book a session',
    text: 'Pick a date, pay a $150 deposit, done in two minutes.',
    href: '/sessions/#book',
    label: 'See open times',
  },
};
---

<BaseLayout>
  {/* No `title` prop on purpose: the home page carries SITE.title verbatim,
      which is the brand + city string search results should show. */}
  <Seo
    slot="head"
    description="Portrait photographer in New York. Cinematic portrait sessions on location, shot like film stills, bookable online."
    ogImage="/og/home.jpg"
  />
  <PersonJsonLd slot="head" name={SITE.person} />
  <h1 class="visually-hidden">Overview: selected work</h1>

  {
    /*
     * Runs synchronously, before the stream below is parsed, so the browser
     * never paints a frame at full opacity and then hides it. Per the fade-up
     * contract: nothing is hidden unless this script has added .fade-up-ready,
     * which it skips entirely under prefers-reduced-motion or without
     * IntersectionObserver.
     */
  }
  <script is:inline>
    (function () {
      var root = document.documentElement;
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      // Safari 26.0 to 26.3 silently drops an HDR <img> to SDR when opacity,
      // transform or transitions apply to it or any ancestor, so on an HDR
      // display there is no fade at all.
      if (window.matchMedia && window.matchMedia('(dynamic-range: high)').matches) return;

      root.classList.add('fade-up-ready');

      function reveal() {
        var targets = document.querySelectorAll('.fade-up');
        if (!targets.length) {
          root.classList.remove('fade-up-ready');
          return;
        }
        var observer = new IntersectionObserver(
          function (entries) {
            for (var i = 0; i < entries.length; i += 1) {
              if (!entries[i].isIntersecting) continue;
              entries[i].target.classList.add('is-visible');
              observer.unobserve(entries[i].target);
            }
          },
          { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
        );
        for (var i = 0; i < targets.length; i += 1) observer.observe(targets[i]);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', reveal, { once: true });
      } else {
        reveal();
      }
    })();
  </script>

  <div class="column-wide bleed stream">
    {
      stream.map((entry, index) => (
        <>
          <StreamFigure entry={entry} lead={index === 0} />
          {STREAM_CTAS[entry.shoot.id] && (
            <aside class="stream-cta">
              <span class="eyebrow">{STREAM_CTAS[entry.shoot.id].eyebrow}</span>
              <p class="stream-cta__text">{STREAM_CTAS[entry.shoot.id].text}</p>
              <a class="stream-cta__link" href={STREAM_CTAS[entry.shoot.id].href}>
                {STREAM_CTAS[entry.shoot.id].label} &rarr;
              </a>
            </aside>
          )}
        </>
      ))
    }

    {
      stream.length === 0 && (
        <p class="faint">
          {/* TODO(ryu): drop a folder into src/content/shoots/ — see README. */}
          No shoots published yet.
        </p>
      )
    }
  </div>
</BaseLayout>

<style>
  /* Editorial interstitial — caption-scale, hairline-framed, deliberately quiet.
     Inherits the stream's rhythm: it reads as a chapter break, not a banner. */
  .stream-cta {
    max-width: 32rem;
    margin: calc(var(--space-8) * 1.25) auto;
    padding: var(--space-6) var(--gutter);
    text-align: center;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .stream-cta__text {
    font-family: var(--serif);
    font-size: 1.12rem;
    line-height: 1.55;
    margin: var(--space-3) 0 var(--space-4);
    text-wrap: balance;
  }

  .stream-cta__link {
    font-family: var(--grotesque);
    font-size: 0.76rem;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    padding-bottom: 2px;
  }

  .stream-cta__link:hover,
  .stream-cta__link:focus-visible {
    border-bottom-color: var(--accent);
  }
</style>
