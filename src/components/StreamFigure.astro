---
/**
 * StreamFigure — one shoot in the Overview stream.
 *
 * Renders the shoot's frames full-width in filename order, then the single
 * caption line that belongs to the whole set (SPEC.md § Content model).
 *
 * Each frame sits in an aspect-ratio box painted with its thumbhash, so the
 * layout is final before a single byte of image data arrives (zero CLS) and the
 * reader sees the photograph's colours immediately.
 *
 * WHY THE MARKUP IS HAND-ROLLED AND NOT <Picture>
 * -----------------------------------------------
 * The masters are HDR gain-map JPEGs. astro:assets strips the gain map from
 * every derivative it produces, so the frames are served from the static ladder
 * scripts/photo-meta.mjs writes into public/photos/ (see SPEC.md § HDR pipeline).
 *
 * The source order is load-bearing:
 *   1. media="(dynamic-range: high)" type="image/jpeg" — the HDR JPEG ladder.
 *   2. type="image/avif" — the SDR ladder, smaller, for everyone else.
 *   3. <img src> — a mid-size JPEG for anything that matches neither.
 * <picture> knows nothing about HDR; it only matches MIME types, and it
 * evaluates `media` before `type`. Without the media-gated JPEG first, an
 * HDR-capable Chrome would happily take the AVIF and render the photo SDR.
 * Putting AVIF first would break HDR everywhere.
 *
 * For an SDR master the first source is just the same plain JPEG ladder — a
 * harmless duplicate that keeps this to a single code path.
 */
import { fallbackRung, srcsetFor, type StreamEntry, type StreamImage } from '../lib/photos';

interface Props {
  entry: StreamEntry;
  /** True for the first shoot: its opening frame is the page's LCP image. */
  lead?: boolean;
}

const { entry, lead = false } = Astro.props;
const { images, caption } = entry;

/**
 * Every frame is capped at 86svh so no photograph exceeds the screen — tall
 * portrait frames shrink-wrap (width follows from the aspect ratio) while
 * landscape frames stay column-bound. The width is computed inline per frame:
 *   width = min(full column, 86svh * aspect-ratio)
 * which keeps the aspect-ratio box exact (zero CLS) with no JS.
 *
 * The column itself is 1100px wide with a --gutter (max 2rem) each side and
 * goes edge-to-edge below 640px — see .column-wide.bleed in global.css.
 */
const sizesFor = (image: StreamImage) => {
  const cap = `calc(86svh * ${(image.width / image.height).toFixed(4)})`;
  return `(min-width: 1100px) min(1036px, ${cap}), (min-width: 640px) min(calc(100vw - 4rem), ${cap}), min(100vw, ${cap})`;
};

const frameStyle = (image: StreamImage) =>
  [
    `aspect-ratio: ${image.width} / ${image.height}`,
    `width: min(100%, calc(86svh * ${(image.width / image.height).toFixed(4)}))`,
    `background-color: ${image.color}`,
    image.thumbhash ? `background-image: url("${image.thumbhash}")` : null,
  ]
    .filter(Boolean)
    .join('; ');

/** Everything the <picture> needs, resolved once per frame. */
const frames = images.map((image, index) => {
  const isLcp = lead && index === 0;
  const fallback = fallbackRung(image.ladder);
  return {
    image,
    isLcp,
    fallback,
    jpegSrcset: srcsetFor(image.ladder, 'jpg'),
    avifSrcset: srcsetFor(image.ladder, 'avif'),
  };
});
---

<figure class="shoot">
  {
    frames.map(({ image, isLcp, fallback, jpegSrcset, avifSrcset }) => (
      <div class:list={['frame', !isLcp && 'fade-up']} style={frameStyle(image)}>
        <picture class="frame__picture">
          <source
            media="(dynamic-range: high)"
            type="image/jpeg"
            srcset={jpegSrcset}
            sizes={sizesFor(image)}
          />
          <source type="image/avif" srcset={avifSrcset} sizes={sizesFor(image)} />
          <img
            src={fallback?.jpg}
            width={fallback?.w}
            height={fallback?.h}
            alt={image.alt}
            class="frame__img"
            loading={isLcp ? 'eager' : 'lazy'}
            decoding={isLcp ? 'sync' : 'async'}
            fetchpriority={isLcp ? 'high' : undefined}
          />
        </picture>
      </div>
    ))
  }
  <figcaption class="caption">{caption}</figcaption>
</figure>

<style>
  .shoot {
    margin: 0;
  }

  /* Air between bodies of work — much wider than the gap inside a set. */
  .shoot + .shoot {
    margin-top: clamp(3.5rem, 9vw, 6.5rem);
  }

  .frame {
    position: relative;
    overflow: hidden;
    /* aspect-ratio, width cap, average colour and thumbhash arrive inline */
    margin-inline: auto;
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    /* Each frame settles into the centre of the viewport as you scroll. */
    scroll-snap-align: center;
  }

  .frame + .frame {
    margin-top: var(--space-4);
  }

  .frame__picture {
    display: block;
    height: 100%;
  }

  .frame__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    /* Frames bleed to the edges, so the caption needs the gutter back. */
    .shoot > .caption {
      padding-inline: var(--gutter);
    }
  }
</style>
