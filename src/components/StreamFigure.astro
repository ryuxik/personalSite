---
/**
 * StreamFigure — one shoot in the Overview stream.
 *
 * Renders the shoot's frames full-width in filename order, then the single
 * caption line that belongs to the whole set (SPEC.md § Content model).
 *
 * Each frame sits in an aspect-ratio box painted with its thumbhash, so the
 * layout is final before a single byte of image data arrives (zero CLS) and the
 * reader sees the photograph's colours immediately.
 *
 * WHY THE MARKUP IS HAND-ROLLED AND NOT <Picture>
 * -----------------------------------------------
 * The masters are HDR gain-map JPEGs. astro:assets strips the gain map from
 * every derivative it produces, so the frames are served from the static ladder
 * scripts/photo-meta.mjs writes into public/photos/ (see SPEC.md § HDR pipeline).
 *
 * The source order is load-bearing:
 *   1. media="(dynamic-range: high)" type="image/jpeg" — the HDR JPEG ladder.
 *   2. type="image/avif" — the SDR ladder, smaller, for everyone else.
 *   3. <img src> — a mid-size JPEG for anything that matches neither.
 * <picture> knows nothing about HDR; it only matches MIME types, and it
 * evaluates `media` before `type`. Without the media-gated JPEG first, an
 * HDR-capable Chrome would happily take the AVIF and render the photo SDR.
 * Putting AVIF first would break HDR everywhere.
 *
 * For an SDR master the first source is just the same plain JPEG ladder — a
 * harmless duplicate that keeps this to a single code path.
 */
import { fallbackRung, srcsetFor, type StreamEntry, type StreamImage } from '../lib/photos';

interface Props {
  entry: StreamEntry;
  /** True for the first shoot: its opening frame is the page's LCP image. */
  lead?: boolean;
}

const { entry, lead = false } = Astro.props;
const { images, caption } = entry;

/**
 * Every frame is capped at 86svh so no photograph exceeds the screen — tall
 * portrait frames shrink-wrap (width follows from the aspect ratio) while
 * landscape frames stay column-bound. The width is computed inline per frame:
 *   width = min(full column, 86svh * aspect-ratio)
 * which keeps the aspect-ratio box exact (zero CLS) with no JS.
 *
 * The column itself is 1100px wide with a --gutter (max 2rem) each side and
 * goes edge-to-edge below 640px — see .column-wide.bleed in global.css.
 */
const sizesFor = (image: StreamImage, share: number) => {
  const cap = `calc(86svh * ${(image.width / image.height).toFixed(4)})`;
  const s = share.toFixed(4);
  // Below 640px pairs stack back to full width, so the last term ignores share.
  return `(min-width: 1100px) min(calc(1036px * ${s}), ${cap}), (min-width: 640px) min(calc((100vw - 4rem) * ${s}), ${cap}), min(100vw, ${cap})`;
};

const ratio = (image: StreamImage) => image.width / image.height;

/**
 * A frame's inline style. `share` is its fraction of a diptych row (1 for a
 * solo row): paired frames split the column proportionally to their aspect
 * ratios so both render at exactly the same height. --r is consumed by the
 * mobile stylesheet override that stacks pairs back to one-per-line.
 */
const frameStyle = (image: StreamImage, share: number) =>
  [
    `aspect-ratio: ${image.width} / ${image.height}`,
    `--r: ${ratio(image).toFixed(4)}`,
    share === 1
      ? `width: min(100%, calc(86svh * var(--r)))`
      : `width: min(calc((100% - var(--space-4)) * ${share.toFixed(4)}), calc(86svh * var(--r)))`,
    `background-color: ${image.color}`,
    image.thumbhash ? `background-image: url("${image.thumbhash}")` : null,
  ]
    .filter(Boolean)
    .join('; ');

/** Everything the <picture> needs, resolved once per frame. */
const frames = images.map((image, index) => {
  const isLcp = lead && index === 0;
  const fallback = fallbackRung(image.ladder);
  return {
    image,
    isLcp,
    fallback,
    jpegSrcset: srcsetFor(image.ladder, 'jpg'),
    avifSrcset: srcsetFor(image.ladder, 'avif'),
  };
});

/**
 * Diptych grouping: consecutive portrait/square frames (ratio <= 1.05) pair
 * into one row at matched heights — a lone portrait column wastes the sides
 * of the screen. Landscapes and unpaired frames keep the full line. The LCP
 * frame always rides solo so its preload math stays simple.
 */
type Frame = (typeof frames)[number];
const pairable = (f: Frame) => ratio(f.image) <= 1.05 && !f.isLcp;
const rows: Frame[][] = [];
for (let i = 0; i < frames.length; ) {
  const a = frames[i];
  const b = frames[i + 1];
  if (b && pairable(a) && pairable(b)) {
    rows.push([a, b]);
    i += 2;
  } else {
    rows.push([a]);
    i += 1;
  }
}
const shareOf = (row: Frame[], f: Frame) =>
  row.length === 1 ? 1 : ratio(f.image) / row.reduce((s, g) => s + ratio(g.image), 0);
---

<figure class="shoot">
  {
    rows.map((row) => (
      <div class:list={['row', row.length === 2 && 'row--pair']}>
        {row.map((f) => (
          <div class:list={['frame', !f.isLcp && 'fade-up']} style={frameStyle(f.image, shareOf(row, f))}>
            <picture class="frame__picture">
              <source
                media="(dynamic-range: high)"
                type="image/jpeg"
                srcset={f.jpegSrcset}
                sizes={sizesFor(f.image, shareOf(row, f))}
              />
              <source type="image/avif" srcset={f.avifSrcset} sizes={sizesFor(f.image, shareOf(row, f))} />
              <img
                src={f.fallback?.jpg}
                width={f.fallback?.w}
                height={f.fallback?.h}
                alt={f.image.alt}
                class="frame__img"
                loading={f.isLcp ? 'eager' : 'lazy'}
                decoding={f.isLcp ? 'sync' : 'async'}
                fetchpriority={f.isLcp ? 'high' : undefined}
              />
            </picture>
          </div>
        ))}
      </div>
    ))
  }
  <figcaption class="caption">{caption}</figcaption>
</figure>

<style>
  .shoot {
    margin: 0;
  }

  /* Air between bodies of work — much wider than the gap inside a set. */
  .shoot + .shoot {
    margin-top: clamp(3.5rem, 9vw, 6.5rem);
  }

  /* A row is one line of the stream: a solo frame or a matched-height diptych.
     Scroll-snap was tried (mandatory, then proximity) and rejected — the
     stream scrolls free; the viewport height cap alone paces the images. */
  .row {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .row + .row {
    margin-top: var(--space-4);
  }

  .frame {
    position: relative;
    overflow: hidden;
    /* aspect-ratio, width, average colour and thumbhash arrive inline */
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
  }

  @media (max-width: 640px) {
    /* Half-width diptychs read stamp-sized on phones — stack them back. */
    .row--pair {
      flex-direction: column;
      align-items: center;
    }

    .row--pair .frame {
      width: min(100%, calc(86svh * var(--r))) !important;
    }
  }

  .frame__picture {
    display: block;
    height: 100%;
  }

  .frame__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 640px) {
    /* Frames bleed to the edges, so the caption needs the gutter back. */
    .shoot > .caption {
      padding-inline: var(--gutter);
    }
  }
</style>
