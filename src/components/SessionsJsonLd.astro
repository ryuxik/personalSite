---
/**
 * SessionsJsonLd — schema.org LocalBusiness + one Service per session tier.
 * LocalBusiness, not ProfessionalService: that type was deprecated by schema.org and
 * was never in Google's supported set. No FAQPage: Google removed FAQ rich results
 * in May 2026 and controlled studies show schema does not drive AI citation.
 * Owned by Agent D; belongs on /sessions only.
 *
 *   <SessionsJsonLd slot="head" />
 *
 * Emitted as a single @graph so the business node, the three service nodes and
 * the FAQ page cross-reference by @id, and all of them link back to
 * PersonJsonLd's `#person`.
 *
 * Locality: driven by SITE.city. While it is empty this component omits
 * `address` and `areaServed` entirely rather than shipping a blank
 * PostalAddress — an empty address is worse than no address for local SEO.
 *
 * Prices mirror the tier cards in src/pages/sessions.astro exactly. They are the
 * "starting at" floor, so each Offer also carries a `priceSpecification` with
 * `minPrice`: a bare `price` that disagrees with the page is a rich-results
 * penalty, and the page says "Starting at $395", not "$395".
 *
 * FAQ answers are the first paragraph of each <Faq> on the page, as plain text.
 * Google requires the answer to appear on the page; keeping this file in step
 * with sessions.astro is manual, so edit both or neither.
 *
 * No em dashes anywhere in the strings below — this is rendered output.
 */
import { SITE } from '../config';

interface ServiceTier {
  /** Slug used for the node @id — keep stable, it is a public identifier. */
  id: string;
  name: string;
  description: string;
  /** Starting price in whole USD, matching the tier card. */
  price: number;
}

interface Props {
  services?: ServiceTier[];
}

// Names, prices and scope must match the tier cards Agent C renders on /sessions.
const DEFAULT_SERVICES: ServiceTier[] = [
  {
    id: 'headshot-session',
    name: 'Headshot Session',
    description:
      'A one-hour headshot sitting, up to two looks, studio or on location, with retouched finals delivered as high-res files and web crops.',
    price: 395,
  },
  {
    id: 'portrait-session',
    name: 'Portrait Session',
    description:
      'A two-hour portrait sitting with up to three looks across one studio setup and one exterior location, planned in advance and edited as a set of finished frames.',
    price: 650,
  },
  {
    id: 'half-day-creative',
    name: 'Half-Day Creative',
    description:
      'A four-hour produced shoot for editorial, campaign and personal-project work, with full pre-production and up to five looks across two or three setups.',
    price: 1450,
  },
];

// One entry per <Faq> in src/pages/sessions.astro, in page order.
const { services = DEFAULT_SERVICES } = Astro.props;

const titleCased = SITE.name.charAt(0) + SITE.name.slice(1).toLowerCase();

const BUSINESS_ID = `${SITE.url}/sessions/#business`;
const PERSON_ID = `${SITE.url}/#person`;
const SESSIONS_URL = `${SITE.url}/sessions/`;

const city = SITE.city.trim();

// Only present when the city is known; spreads to nothing otherwise.
const locality = city
  ? {
      address: { '@type': 'PostalAddress', addressLocality: city },
      areaServed: { '@type': 'City', name: city },
    }
  : {};

const serviceNodes = services.map((tier) => ({
  '@type': 'Service',
  '@id': `${SITE.url}/sessions/#${tier.id}`,
  name: tier.name,
  serviceType: 'Photography',
  description: tier.description,
  provider: { '@id': BUSINESS_ID },
  ...(city ? { areaServed: { '@type': 'City', name: city } } : {}),
}));

/** The tier prices are floors, so both `price` and a minPrice specification. */
const offerFor = (tier: ServiceTier) => ({
  '@type': 'Offer',
  '@id': `${SITE.url}/sessions/#offer-${tier.id}`,
  name: tier.name,
  url: `${SITE.url}/sessions/#investment`,
  price: String(tier.price),
  priceCurrency: 'USD',
  priceSpecification: {
    '@type': 'PriceSpecification',
    minPrice: String(tier.price),
    priceCurrency: 'USD',
    valueAddedTaxIncluded: false,
  },
  availability: 'https://schema.org/InStock',
  itemOffered: { '@id': `${SITE.url}/sessions/#${tier.id}` },
});

const business = {
  '@type': 'LocalBusiness',
  '@id': BUSINESS_ID,
  name: `${titleCased} Photography`,
  url: SESSIONS_URL,
  description:
    'Photography sessions: headshots, portraits, and half-day creative work, booked directly.',
  image: new URL('/og/sessions.jpg', SITE.url).href,
  email: `mailto:${SITE.email}`,
  priceRange: '$$',
  founder: { '@id': PERSON_ID },
  provider: { '@id': PERSON_ID },
  ...(SITE.instagram ? { sameAs: [SITE.instagram] } : {}),
  ...locality,
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Photography sessions',
    itemListElement: services.map(offerFor),
  },
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [business, ...serviceNodes],
};

// Escape "<" so a stray "</script>" inside any string can never close this block early.
const json = JSON.stringify(graph).replace(/</g, '\\u003c');
---

<script type="application/ld+json" is:inline set:html={json} />
