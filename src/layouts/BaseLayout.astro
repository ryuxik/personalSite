---
/**
 * BaseLayout — the site shell. Owned by Agent A (see SPEC.md § Ownership map).
 *
 * Slots:
 *   "head"    — head extras. Agent D injects <Seo /> + JSON-LD here.
 *   default   — page body, rendered inside <main id="main" class="site-main">.
 *               Pages supply their own .column / .column-wide container.
 *
 * Props are a minimal fallback for <title>/<meta description>; once Agent D's
 * <Seo /> component lands, pages pass their metadata through that instead and
 * the fallback tags below are skipped whenever the "head" slot is filled.
 */
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/archivo/wght.css';
/**
 * The two latin-subset variable faces that every page paints text with, imported
 * for their *built* URLs so they can be preloaded. `?url` runs them through the
 * same Vite asset pipeline the @font-face rules above use, so the href is the
 * real fingerprinted /_astro/ path and stays correct across builds — a
 * hardcoded hash would 404 the moment a font package updates.
 *
 * Only latin + only the upright weight axis: those are the files needed to
 * paint the first screen. The italic and latin-ext subsets load on demand from
 * the stylesheet, as they should.
 */
import newsreaderLatinUrl from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import archivoLatinUrl from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import '../styles/global.css';
import { SITE } from '../config';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const { title, description, bodyClass } = Astro.props;

const pageTitle = title ? `${title} · ${SITE.business}` : SITE.title;
const pageDescription = description ?? SITE.description;

// Trailing slash tolerant, so "/sessions" and "/sessions/" both mark active.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';

// Canonical keeps Astro's own path shape (directory format => trailing slash) so it
// matches what @astrojs/sitemap emits. Agent D's <Seo /> should do the same.
const canonical = new URL(Astro.url.pathname, SITE.url).href;

const NAV = [
  { href: '/', label: 'Overview' },
  { href: '/sessions', label: 'Sessions' },
  { href: '/diary', label: 'Diary' },
  { href: '/information', label: 'Information' },
] as const;

const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`));

const hasHeadExtras = Astro.slots.has('head');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F1EEE5" />

    {/* Icons. SVG first for anything modern; the PNG is the fallback, and
        apple-touch-icon is what iOS uses when the site is added to the home screen. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    {/* Fonts the first paint needs. Both are self-hosted, so `crossorigin` is
        still required: a preload without it fetches in a different CORS mode
        than the @font-face request and the file is downloaded twice. */}
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatinUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={archivoLatinUrl} crossorigin />

    {
      /* Fallback metadata — superseded by <Seo /> once Agent D fills the "head" slot. */
      !hasHeadExtras && (
        <Fragment>
          <title>{pageTitle}</title>
          <meta name="description" content={pageDescription} />
          <link rel="canonical" href={canonical} />
        </Fragment>
      )
    }

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <a class="wordmark" href="/" aria-label={`${SITE.name}, home`}>{SITE.name}</a>

      <nav class="nav nav--desktop" aria-label="Primary">
        <ul class="nav__list">
          {
            NAV.map((item) => (
              <li>
                <a
                  class="nav__link"
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="nav nav--mobile" aria-label="Primary, compact">
        <details class="menu">
          <summary>Menu</summary>
          <div class="menu__panel">
            <ul>
              {
                NAV.map((item) => (
                  <li>
                    <a
                      class="nav__link"
                      href={item.href}
                      aria-current={isActive(item.href) ? 'page' : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </details>
      </nav>
    </header>

    <main id="main" class="site-main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <span>© 2026 {SITE.business}</span>
        <span class="site-footer__sep" aria-hidden="true">·</span>
        <a href="/sessions/">Sessions</a>
        <span class="site-footer__sep" aria-hidden="true">·</span>
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        <span class="site-footer__sep" aria-hidden="true">·</span>
        <a href={SITE.instagram} rel="me noopener noreferrer" target="_blank">Instagram</a>
      </p>
    </footer>

    {
      /* Cloudflare Web Analytics. Cookieless, no personal data, ~1 request.
         Emitted only when SITE.analyticsToken is set, so the default build ships
         zero third-party script tags. The CSP in public/_headers already allows
         static.cloudflareinsights.com so pasting a token needs no other change. */
      SITE.analyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${SITE.analyticsToken}"}`}
        />
      )
    }
  </body>
</html>
