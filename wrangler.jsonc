// Cloudflare Workers deploy for the Astro site + the Selects client galleries.
// `npx wrangler deploy` (the Workers Builds deploy command) reads this.
//
// The static site is untouched: every path EXCEPT the three run_worker_first
// globs below is served straight from ./dist as before. The Worker only owns
// the private-gallery surface (SPEC.md § Client galleries):
//   /g/*      client galleries (capability URLs — the link is the credential)
//   /api/*    admin + gallery APIs
//   /admin*   the photographer's admin (put Cloudflare Access in front of it)
//
// Provisioning (once, see docs/LAUNCH.md § Selects):
//   npx wrangler r2 bucket create selects-media
//   npx wrangler d1 create selects-db        → database_id below (created 2026-08-26)
//   npx wrangler secret put SELECTS_ADMIN_TOKEN
//   npx wrangler secret put RESEND_API_KEY   (optional — email is a no-op without it)
{
  "name": "personalsite",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  // The workers.dev origin would serve this same Worker OUTSIDE the zone's
  // Cloudflare Access — with Access + a service token in force on ryuxik.io,
  // that side door must stay shut (review finding).
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": ["/g/*", "/api/*", "/admin", "/admin/*"]
  },
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "selects-media" }
  ],
  "d1_databases": [
    // database_id is filled in after `npx wrangler d1 create selects-db`;
    // wrangler dev --local works with the placeholder untouched.
    { "binding": "DB", "database_name": "selects-db", "database_id": "1964cf37-0334-4034-9277-3167153eeb9f" }
  ],
  // Cloudflare-native outbound email (free): requires Email Routing enabled
  // on the zone with the destination address verified — docs/LAUNCH.md § Selects
  // step 6. Until then this binding still deploys; sends fail over to Resend
  // (if configured) or log as no-ops without losing notification state.
  "send_email": [{ "name": "NOTIFY" }],
  // Per-IP ceiling on the public funnel beacon, POST /api/e (SPEC.md § Site
  // analytics). The IP is only the limiter's key at the edge — never stored.
  "ratelimits": [
    { "name": "TRACK_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } }
  ],
  "triggers": {
    // Daily lifecycle pass: expiry warnings, trash-grace deletes, purge,
    // storage-vs-DB reconciliation, comment digest. worker/cron.ts.
    "crons": ["17 6 * * *"]
  },
  "vars": {
    // Where lifecycle + digest email goes. Sender domain is configured in
    // Resend (mail.ryuxik.io — the zone apex deliberately has no MX/TXT).
    "PHOTOGRAPHER_EMAIL": "ryuxik@gmail.com",
    "EMAIL_FROM": "Selects <selects@mail.ryuxik.io>",
    "PUBLIC_ORIGIN": "https://ryuxik.io",
    // Access JWT verification: a valid, signed Access login for this app (and
    // this email) IS an admin session — the token form is the fallback only.
    "ACCESS_TEAM_DOMAIN": "lucky-star-0196.cloudflareaccess.com",
    "ACCESS_AUD": "a74ce4f2850c89fb3f1a3910c254620fffe603d1d5a5004c7f96f404b247bb1b"
  }
}
